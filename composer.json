{
    "name": "valksor/typesafe-sdk-php",
    "description": "Unofficial, unaffiliated PHP SDK for the TypeSafe AI System One API, with 1:1 parity to the official JavaScript and Python SDKs.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "TypeSafe\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TypeSafe\\Tests\\": "tests/"
        }
    },
    "archive": {
        "exclude": [
            "/.github",
            "/.gitignore",
            "/.phpstan.cache",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/composer.lock",
            "/phpstan.neon",
            "/phpunit.xml",
            "/tests",
            "/vendor"
        ]
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l"
    },
    "support": {
        "docs": "https://docs.typesafe.ai/api",
        "issues": "https://github.com/valksor/typesafe-sdk-php/issues",
        "source": "https://github.com/valksor/typesafe-sdk-php"
    }
}
